# Public site URL (link previews, email links)
NEXT_PUBLIC_SITE_URL=https://airpool.example
# Admin waitlist view at /admin (HTTP Basic auth, any username). Unset = admin disabled.
ADMIN_PASSWORD=
# Waitlist confirmation emails via Resend (https://resend.com). Unset = no emails sent.
RESEND_API_KEY=
EMAIL_FROM="AirPool <hello@your-domain>"
# Privacy-friendly analytics via Plausible (domain as registered there). Unset = no analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional custom MapLibre style
NEXT_PUBLIC_MAP_STYLE_URL=
